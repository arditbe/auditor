# Copy to .env in this directory before running `adk web` or deploying.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1

# Which Google model judges. Any of: gemini-flash-latest, gemini-pro-latest.
AUDITOR_AGENT_MODEL=gemini-flash-latest

# Optional bearer token for the model under test.
# AUDITOR_TARGET_API_KEY=
