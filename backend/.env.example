# Copy to backend/.env. Every value here is a default — an empty file works.

# --- Google Cloud (leave blank to run fully local and free) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1

# --- Storage: "memory" or "firestore" ---
STORE_BACKEND=memory
FIRESTORE_COLLECTION=auditor_runs

# --- Local model daemon ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_KEEP_ALIVE=20m

# --- Run tuning ---
TARGET_TIMEOUT_S=90
JUDGE_TIMEOUT_S=120
# Raise to slow a live demo down so each step is readable.
PROBE_DELAY_S=0
